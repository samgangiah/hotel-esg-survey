// Hotel ESG Survey platform — data model
// See PROJECT.md §3 for the rationale behind every choice.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Tenancy & physical structure
//
// The customer is an Operator (hotel group / chain / management company).
// Sites belong to an Operator. Buildings belong to a Site.
// -----------------------------------------------------------------------------

model Operator {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  // Set when the customer has finished the first-run setup wizard
  // (named their first hotel etc). Null = show the wizard on /operator.
  setupCompletedAt DateTime?

  sites       Site[]
  respondents Respondent[]
}

model Site {
  id                String    @id @default(cuid())
  operatorId        String
  name              String
  address           String?
  primaryBuildingId String?   @unique
  createdAt         DateTime  @default(now())
  deletedAt         DateTime?

  operator        Operator         @relation(fields: [operatorId], references: [id])
  buildings       Building[]       @relation("SiteBuildings")
  primaryBuilding Building?        @relation("PrimaryBuilding", fields: [primaryBuildingId], references: [id])
  surveyInstances SurveyInstance[]

  @@index([operatorId])
}

model Building {
  id        String    @id @default(cuid())
  siteId    String
  name      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  site        Site         @relation("SiteBuildings", fields: [siteId], references: [id])
  primaryFor  Site?        @relation("PrimaryBuilding")
  answers     Answer[]
  assignments Assignment[]

  @@index([siteId])
}

// -----------------------------------------------------------------------------
// Survey templates (versioned, immutable per version)
// -----------------------------------------------------------------------------

model SurveyTemplate {
  id         String   @id @default(cuid())
  slug       String
  version    Int
  schemaJson Json
  createdAt  DateTime @default(now())

  instances SurveyInstance[]

  @@unique([slug, version])
}

// -----------------------------------------------------------------------------
// Survey instances and answers
// -----------------------------------------------------------------------------

enum SurveyInstanceStatus {
  draft
  in_progress
  submitted
  locked
  abandoned
}

model SurveyInstance {
  id                 String               @id @default(cuid())
  siteId             String
  templateId         String
  status             SurveyInstanceStatus @default(draft)
  windowOpensAt      DateTime?
  windowClosesAt     DateTime?
  previousInstanceId String?
  createdAt          DateTime             @default(now())
  lockedAt           DateTime?

  site               Site                @relation(fields: [siteId], references: [id])
  template           SurveyTemplate      @relation(fields: [templateId], references: [id])
  previous           SurveyInstance?     @relation("Repeat", fields: [previousInstanceId], references: [id])
  next               SurveyInstance[]    @relation("Repeat")
  assignments        Assignment[]
  answers            Answer[]
  reports            Report[]
  sectionSubmissions SectionSubmission[]
  uploadedFiles      UploadedFile[]
  delegations        QuestionDelegation[]

  @@index([siteId])
  @@index([status])
}

// -----------------------------------------------------------------------------
// People — Respondents are the user-facing identity. No accounts, no passwords.
// The Operator Admin is just a Respondent with isOperatorAdmin = true.
// -----------------------------------------------------------------------------

model Respondent {
  id              String    @id @default(cuid())
  operatorId      String
  email           String
  name            String
  phone           String?
  isOperatorAdmin Boolean   @default(false)
  emailInvalid    Boolean   @default(false)
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  operator           Operator            @relation(fields: [operatorId], references: [id])
  assignments        Assignment[]
  answers            Answer[]
  sessions           Session[]
  sectionSubmissions SectionSubmission[]
  uploadedFiles      UploadedFile[]

  delegationsCreated  QuestionDelegation[] @relation("DelegationFrom")
  delegationsReceived QuestionDelegation[] @relation("DelegationTo")

  @@unique([operatorId, email])
  @@index([operatorId])
}

// -----------------------------------------------------------------------------
// Assignments — the unit of work
// -----------------------------------------------------------------------------

model Assignment {
  id               String   @id @default(cuid())
  surveyInstanceId String
  respondentId     String
  role             String   // gm | engineering | housekeeping | laundry | finance | energy_manager
  sectionId        String   // matches questions.json section.id (or 'all' for operator admins)
  buildingId       String?  // null for site/org-level sections
  status           String   @default("pending") // pending | opened | submitted | abandoned
  createdAt        DateTime @default(now())

  surveyInstance SurveyInstance @relation(fields: [surveyInstanceId], references: [id])
  respondent     Respondent     @relation(fields: [respondentId], references: [id])
  building       Building?      @relation(fields: [buildingId], references: [id])
  invitations    Invitation[]

  @@unique([surveyInstanceId, respondentId, role, sectionId, buildingId])
  @@index([surveyInstanceId])
  @@index([respondentId])
}

model Answer {
  id               String   @id @default(cuid())
  surveyInstanceId String
  questionId       String
  buildingId       String   // always anchored to a building (site-level → site.primaryBuildingId)
  respondentId     String
  valueJson        Json
  answeredAt       DateTime @default(now())
  updatedAt        DateTime @updatedAt

  surveyInstance SurveyInstance @relation(fields: [surveyInstanceId], references: [id])
  building       Building       @relation(fields: [buildingId], references: [id])
  respondent     Respondent     @relation(fields: [respondentId], references: [id])

  @@unique([surveyInstanceId, questionId, buildingId])
  @@index([surveyInstanceId])
  @@index([respondentId])
}

// -----------------------------------------------------------------------------
// Per-respondent per-section "I'm done with my part" marker.
// -----------------------------------------------------------------------------

model SectionSubmission {
  id               String   @id @default(cuid())
  surveyInstanceId String
  respondentId     String
  sectionId        String   // matches questions.json section.id
  submittedAt      DateTime @default(now())

  surveyInstance SurveyInstance @relation(fields: [surveyInstanceId], references: [id])
  respondent     Respondent     @relation(fields: [respondentId], references: [id])

  @@unique([surveyInstanceId, respondentId, sectionId])
  @@index([surveyInstanceId])
}

// -----------------------------------------------------------------------------
// Uploaded files (energy bills, EPC certificates, machine photos, etc.)
// Storage backend starts as 'local' (bind-mounted folder on the VPS) and can
// migrate to 'r2' later without changing the Answer.valueJson shape.
// -----------------------------------------------------------------------------

model UploadedFile {
  id               String    @id @default(cuid())
  surveyInstanceId String
  questionId       String    // matches questions.json (or sub-question id within a repeater)
  buildingId       String    // same anchor convention as Answer
  respondentId     String    // who uploaded

  // Where, within a repeater question, this file lives. Both null for
  // top-level questions (energy bills, EPC certificate, guest comms).
  repeaterParentId String?
  repeaterIndex    Int?

  filename         String    // original filename for display
  byteSize         Int
  mimeType         String

  storageBackend   String    @default("local") // 'local' | 'r2'
  storagePath      String                      // relative path under uploads root

  createdAt        DateTime  @default(now())
  deletedAt        DateTime?                   // soft-delete; cron purges the blob later

  surveyInstance SurveyInstance @relation(fields: [surveyInstanceId], references: [id])
  respondent     Respondent     @relation(fields: [respondentId], references: [id])

  @@index([surveyInstanceId])
  @@index([surveyInstanceId, questionId, buildingId])
  @@index([respondentId])
}

// -----------------------------------------------------------------------------
// Question delegation — any respondent can hand a single question off to
// another email address. The recipient gets a one-question micro-page via a
// magic link and can answer or further forward it. The chain is tracked via
// `parentDelegationId` so we can show "answered by Carol (via Bob)".
// -----------------------------------------------------------------------------

model QuestionDelegation {
  id                      String    @id @default(cuid())
  surveyInstanceId        String
  questionId              String
  buildingId              String     // anchor for the Answer row written when answered

  delegatedByRespondentId String     // who clicked Delegate
  delegatedToEmail        String     // who they're handing it to
  delegatedToName         String?    // optional friendly name
  delegatedToRespondentId String?    // populated once the delegate is materialised on first save

  tokenHash               String    @unique
  note                    String?    // optional message from the delegator

  createdAt               DateTime  @default(now())
  expiresAt               DateTime
  answeredAt              DateTime?  // set when the delegate submits
  cancelledAt             DateTime?  // set when the delegator cancels
  parentDelegationId      String?    // set when this row was created by forwarding

  surveyInstance SurveyInstance      @relation(fields: [surveyInstanceId], references: [id])
  delegatedBy    Respondent          @relation("DelegationFrom", fields: [delegatedByRespondentId], references: [id])
  delegatedTo    Respondent?         @relation("DelegationTo", fields: [delegatedToRespondentId], references: [id])
  parent         QuestionDelegation? @relation("DelegationChain", fields: [parentDelegationId], references: [id])
  children       QuestionDelegation[] @relation("DelegationChain")

  @@index([surveyInstanceId])
  @@index([surveyInstanceId, questionId, buildingId])
  @@index([delegatedByRespondentId])
}

// -----------------------------------------------------------------------------
// Auth: magic links + non-transferable session binding
// -----------------------------------------------------------------------------

model Invitation {
  id             String    @id @default(cuid())
  assignmentId   String
  tokenHash      String    @unique
  sentAt         DateTime  @default(now())
  openedAt       DateTime?
  boundSessionId String?   @unique
  expiresAt      DateTime

  // Reminder cadence — auto-reminders fire at 5/10/21 days after sentAt.
  // `remindersSent` is a running count (0..3), `lastReminderAt` blocks
  // multiple reminders within a 24-hour window if cron fires more than once.
  remindersSent  Int       @default(0)
  lastReminderAt DateTime?

  assignment   Assignment   @relation(fields: [assignmentId], references: [id])
  boundSession Session?     @relation("InvitationBinding", fields: [boundSessionId], references: [id])
  emailEvents  EmailEvent[]

  @@index([assignmentId])
}

model Session {
  id           String   @id @default(cuid())
  respondentId String
  ip           String?
  userAgent    String?
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())
  expiresAt    DateTime

  respondent Respondent  @relation(fields: [respondentId], references: [id])
  invitation Invitation? @relation("InvitationBinding")

  @@index([respondentId])
}

// -----------------------------------------------------------------------------
// Platform Admin (Sam) — separate auth surface, separate sessions
// -----------------------------------------------------------------------------

model PlatformAdmin {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())

  sessions PlatformAdminSession[]
}

model PlatformAdminSession {
  id              String   @id @default(cuid())
  platformAdminId String
  ip              String?
  userAgent       String?
  createdAt       DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  expiresAt       DateTime

  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id])

  @@index([platformAdminId])
}

model PlatformAdminLoginToken {
  id         String    @id @default(cuid())
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
}

// -----------------------------------------------------------------------------
// Reports
// -----------------------------------------------------------------------------

model Report {
  id               String   @id @default(cuid())
  surveyInstanceId String
  generatedAt      DateTime @default(now())
  snapshotJson     Json
  pdfPath          String?
  status           String   @default("pending") // pending | generating | ready | failed

  surveyInstance SurveyInstance @relation(fields: [surveyInstanceId], references: [id])

  @@index([surveyInstanceId])
}

// -----------------------------------------------------------------------------
// Observability: email events + audit log
// -----------------------------------------------------------------------------

model EmailEvent {
  id           String   @id @default(cuid())
  invitationId String
  eventType    String   // delivered | bounced | opened | complained | failed
  occurredAt   DateTime @default(now())
  payloadJson  Json

  invitation Invitation @relation(fields: [invitationId], references: [id])

  @@index([invitationId])
  @@index([eventType])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorType   String   // platform_admin | respondent | system
  actorId     String?
  action      String
  targetType  String
  targetId    String
  payloadJson Json?
  occurredAt  DateTime @default(now())
  ip          String?

  @@index([targetType, targetId])
  @@index([actorType, actorId])
}
