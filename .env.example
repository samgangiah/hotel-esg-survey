# --- Required ---------------------------------------------------------------

# Postgres password (used by both phs-app and phs-db).
POSTGRES_PASSWORD=

# Signs session cookies. Rotate via overlap window — never just replace.
# Generate with: openssl rand -hex 32
SESSION_SIGNING_KEY=

# Sole address allowed to log in to /admin.
PLATFORM_ADMIN_EMAIL=samendran@gmail.com

# Base URL the app uses to construct invite links.
APP_URL=https://phs.digitalstorm.cloud

# --- Email (Phase 0.D, not required at boot) --------------------------------

RESEND_API_KEY=
RESEND_FROM=PHS Energy <invites@mail.digitalstorm.cloud>

# --- File storage (Phase 0.F) -----------------------------------------------

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# --- Observability (Phase 0.F) ----------------------------------------------

SENTRY_DSN=
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=

# --- Set automatically by docker-compose if you don't override ---------------

# DATABASE_URL=postgresql://esg:${POSTGRES_PASSWORD}@phs-db:5432/esg?schema=public
